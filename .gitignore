# Never commit your real keys
.env

__pycache__/
*.pyc
finperson.db
finperson_demo.db
backups/
.DS_Store
.claude/settings.local.json
*.log

# RAG index — rebuilt automatically at deploy time (see nixpacks.toml), not
# source. rag/corpus_js.json IS committed (see rag/build_index.py's
# docstring for why): it's the checked-in snapshot rag.build_index reads at
# build time, so Railway's Python-only container never needs Node installed
# just to extract content from idm.js/learn.js.
rag/chroma_db/

# Trained model artifacts — timestamped binaries produced by
# ml.train_*.py, not source. ml/archetype_profiles.json IS committed (same
# reasoning as rag/corpus_js.json above). ml/baselines/*.json is ALSO
# committed, deliberately NOT ignored here — a drift check is meaningless
# if its reference point resets on every CI checkout; see ml/drift.py and
# .github/workflows/ml_retrain.yml.
ml/artifacts/
