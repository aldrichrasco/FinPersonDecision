# Copy this file to .env (same folder as server.py) and fill in what you
# need. Nothing here is required to run the app locally — every value has a
# safe fallback (SQLite instead of Postgres, print-to-console instead of
# real email, coaching chat disabled instead of crashing). Fill in only the
# pieces you're actually turning on. See SETUP.md for the coaching-chat
# walkthrough specifically.

# --- Coaching chat (Anthropic) ------------------------------------------
# Get a key at https://console.anthropic.com -> API Keys -> Create Key.
# Without this, the quiz and sandbox still work; chat just stays disabled.
ANTHROPIC_API_KEY=sk-ant-paste-your-key-here
LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5
# LLM_MAX_TOKENS=1024

# Only needed if you set LLM_PROVIDER to a different provider.
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# --- Sessions / cookies --------------------------------------------------
SECRET_KEY=any-long-random-string-you-like
# Set to 1 in production (HTTPS) — leave 0 for local http://localhost dev.
COOKIE_SECURE=0

# --- Database -------------------------------------------------------------
# Leave unset for local dev — falls back to a SQLite file automatically.
# Render sets this for you when you attach the Postgres instance from
# render.yaml; only set it by hand if you're pointing at a database you
# manage yourself.
# DATABASE_URL=
# SQLITE_PATH=finperson.db

# --- Google sign-in --------------------------------------------------------
# From https://console.cloud.google.com/apis/credentials — must also be set
# to the same value in auth.js.
# GOOGLE_CLIENT_ID=

# --- Transactional email (password reset) ----------------------------------
# Any SMTP provider works: a Gmail app password, SendGrid, Mailgun, etc.
# Without this, reset emails print to the server console instead of sending
# — fine for local dev, not for anyone but you.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# --- CORS -------------------------------------------------------------------
# Comma-separated origins allowed to call the API with credentials, if the
# frontend is ever hosted on a different origin than the API.
# ALLOWED_ORIGIN=https://your-deployed-domain.com

# --- Safeguarding / consent --------------------------------------------------
SAFEGUARDING_REGION=generic
# CONSENT_VERSION=

# --- Feature flags (all default on) -----------------------------------------
# QUIZ_GENERATION=1
# QUIZ_GENERATION_IN_STUDY=0
# SCENARIO_GENERATION=1
# SCENARIO_GENERATION_IN_STUDY=0

# --- Backups (backup.py) -----------------------------------------------------
# BACKUP_DIR=backups
# BACKUP_KEEP=14

# --- Misc ---------------------------------------------------------------------
# FLASK_DEBUG=0
# PORT=5000
