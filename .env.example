# ===========================================================================
# FinPerson configuration
#
# HOW TO USE
#   1. Copy this file. Name the copy exactly:  .env
#   2. Fill in the values you need (only the first section is required)
#   3. Run:  python3 server.py   then open http://localhost:5000
#
# .env is git-ignored, so your keys stay on your machine.
# Real environment variables always override this file — which is why the
# same codebase works locally and on Render without changes.
# ===========================================================================


# ---------------------------------------------------------------------------
# 1. REQUIRED FOR THE COACH
# ---------------------------------------------------------------------------

# Powers the coaching chat and generated scenarios.
# Get one at https://console.anthropic.com -> API Keys -> Create Key
# Without it: quiz and sandbox work fully; the chat says coaching isn't enabled.
ANTHROPIC_API_KEY=sk-ant-paste-your-key-here

# Signs session cookies. Any long random string.
# On Render, let it generate this for you.
SECRET_KEY=change-me-to-any-long-random-string

# Set 0 for local http, 1 for anything served over https.
# Wrong value = logins silently fail to persist.
COOKIE_SECURE=0


# ---------------------------------------------------------------------------
# 2. THE MODEL
# ---------------------------------------------------------------------------

# anthropic (default) | openai | gemini
# Switching providers needs no code change — see llm.py.
LLM_PROVIDER=anthropic

# Override the per-provider default model.
# LLM_MODEL=claude-haiku-4-5-20251001

# Reply length ceiling. Coaching replies are short by design.
# LLM_MAX_TOKENS=400

# Only needed if you switch LLM_PROVIDER.
# OPENAI_API_KEY=
# GOOGLE_API_KEY=


# ---------------------------------------------------------------------------
# 3. SAFEGUARDING  —  read this before deploying to real users
# ---------------------------------------------------------------------------

# Which support directory to serve: generic | nz
# !! Phone numbers ship BLANK on purpose. Publishing a wrong crisis number is
# !! worse than publishing none. Verify every contact detail in safeguarding.py
# !! and localise it before real users reach this.
SAFEGUARDING_REGION=generic


# ---------------------------------------------------------------------------
# 4. RESEARCH  —  affects data validity, read carefully
# ---------------------------------------------------------------------------

# Bump this when the information sheet or protocol changes. Participants who
# consented under an older version stop being recorded until they re-consent.
CONSENT_VERSION=1.0

# LLM-generated scenarios on top of the authored pool. 1 = on, 0 = off.
SCENARIO_GENERATION=1

# !! STIMULUS CONTROL. Leave at 0 for any trial.
# !! If enrolled participants receive generated scenarios, people in the same
# !! arm see different content — and have not received the same intervention.
# !! Only set 1 if your protocol explicitly permits it.
SCENARIO_GENERATION_IN_STUDY=0


# ---------------------------------------------------------------------------
# 5. DATABASE
# ---------------------------------------------------------------------------

# Postgres connection string. Render supplies this automatically when you
# attach a database. Leave blank locally to use SQLite.
# DATABASE_URL=

# Where the local SQLite file lives when DATABASE_URL is unset.
# SQLITE_PATH=finperson.db


# ---------------------------------------------------------------------------
# 6. GOOGLE SIGN-IN  (optional — the app works without accounts)
# ---------------------------------------------------------------------------

# From https://console.cloud.google.com/apis/credentials (Web application).
# Add your domain to "Authorized JavaScript origins", and set the same value
# in auth.js.
# GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com


# ---------------------------------------------------------------------------
# 7. SERVER
# ---------------------------------------------------------------------------

# Comma-separated origins allowed to call the API from a browser.
# Only needed when the frontend is served from a different domain.
# ALLOWED_ORIGIN=https://your-app.onrender.com

# PORT=5000
# FLASK_DEBUG=0


# ---------------------------------------------------------------------------
# 8. BACKUPS  (see backup.py)
# ---------------------------------------------------------------------------

# BACKUP_DIR=backups
# BACKUP_KEEP=14
